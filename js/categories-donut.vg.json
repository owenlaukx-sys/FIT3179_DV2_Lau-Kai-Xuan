{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json", 
    "width": 550, 
    "height": 450, 
    "autosize": {
        "type": "fit-y",
        "contains": "padding",
        "resize": true
    },
    "title": {
        "text": "Categories of Cultural Events in Australia 2026",
        "subtitle": "Major Categories for Australian Events",
        "anchor": "start",
        "fontSize": 24,
        "subtitleFontSize": 18,
        "offset": 14
    },
    "data": {
        "url": "data/Australian_Cultural_Events_List_2026.csv"
    }, 

    "transform": [
        {
            "aggregate": [
            {
                "op": "count",
                "as": "Event_Count"
            }
            ],
            "groupby": ["Category"]
        },
        {
            "joinaggregate": [
            {
                "op": "sum",
                "field": "Event_Count",
                "as": "Total_Events"
            }
            ]
        },
        {
            "calculate": "datum['Event_Count'] / datum['Total_Events']",
            "as": "Proportion"
        }
    ],

    "mark": {
        "type": "arc",
        "innerRadius": 80,
        "outerRadius": 160
    },

    "encoding": {
        "theta": {
            "field": "Event_Count",
            "type": "quantitative",
            "stack": true
        }, 

        "color": {
            "field": "Category",
            "type": "nominal",
            "scale": {
                "domain": [
                    "Arts & Culture",
                    "Music",
                    "Sports",
                    "Indigenous",
                    "Food & Drink",
                    "Film & Literature",
                    "Multicultural & Community"
                ],
                "range": [
                    "#0072B2",
                    "#E69F00",
                    "#009E73",
                    "#CC79A7",
                    "#D55E00",
                    "#56B4E9",
                    "#F0E442"
                ]
            },
            "legend": {"title": "Event Category"}
        },

        "tooltip": [
            {"field": "Category", "type": "nominal"},
            {"field": "Event_Count", "type": "quantitative", "title": "Number of Events"}, 
            {"field": "Proportion", "type": "quantitative", "title": "Proportion", "format": ".1%"}
        ]
    }
}