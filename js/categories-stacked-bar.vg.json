{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

    "width": 600,
    "height": 300,

    "data": {
        "url": "data/Australian_Cultural_Events_List_2026.csv"
    },

    "transform": [
        {
        "aggregate": [
            {
                "op": "count",
                "as": "Event_Count"
            }
        ],
        "groupby": [
            "State",
            "Category"
        ]
        }
    ],

    "mark": {
        "type": "bar"
    },

    "encoding": {
        "x": {
            "field": "Event_Count",
            "type": "quantitative",
            "title": "Number of Events"
        },

        "y": {
            "field": "State",
            "type": "nominal",
            "title": "State",
            "sort": "-x"
        },

        "color": {
            "field": "Category",
            "type": "nominal",
            "scale": {
                "domain": [
                    "Arts & Culture",
                    "Music",
                    "Sports",
                    "Indigenous",
                    "Food & Drink",
                    "Film & Literature",
                    "Multicultural & Community"
                ],
                "range": [
                    "#0072B2",
                    "#E69F00",
                    "#009E73",
                    "#CC79A7",
                    "#D55E00",
                    "#56B4E9",
                    "#F0E442"
                ]
            },
            "legend": {"title": "Event Category"}
        },

        "tooltip": [
        {
            "field": "State",
            "type": "nominal",
            "title": "State"
        },
        {
            "field": "Category",
            "type": "nominal",
            "title": "Category"
        },
        {
            "field": "Event_Count",
            "type": "quantitative",
            "title": "Number of Events"
        }
        ]
    }
}