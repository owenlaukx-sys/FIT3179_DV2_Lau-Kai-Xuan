{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json", 
    "width": 800, 
    "height": 600, 
    "projection": {"type": "equirectangular"},
    "layer": [
        {
            "data": {
                "url": "js/maps/australia_map.json", 
                "format": {"type": "topojson", "feature": "ne_50m_admin_1_states_provinces"}
            }, 
            "mark": {"type": "geoshape", "fill": "white", "stroke": "gray"}
        }, 

        {
            "data": {
                "url": "data/Australian_Cultural_Events_List_2026.csv", 
                "format": {
                    "type": "csv"
                }
            }, 

            "transform": [
                {
                    "aggregate": [{"op": "count", "as": "Event_Count"}], 
                    "groupby": ["City", "State", "City Latitude", "City Longitude"]
                }
            ], 

            "mark": {
                "type": "circle", 
                "opacity": 0.7, 
                "stroke": "black"
            }, 
            "encoding": {
                "longitude": {
                    "field": "City Longitude", 
                    "type": "quantitative"
                }, 
                "latitude": {
                    "field": "City Latitude", 
                    "type": "quantitative"
                }, 

                "size": {
                    "field": "Event_Count", 
                    "type": "quantitative", 
                    "scale": {"range": [50, 1000], "zero": false}, 
                    "legend": {"title": "Number of Events"}
                }, 

                "tooltip": [
                    {"field": "City", "type": "nominal"}, 
                    {"field": "State", "type": "nominal"}, 
                    {"field": "Event_Count", "type": "quantitative", "title": "Number of Events"}
                ]
            }
        }
    ]
}