{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

    "width": 800,
    "height": 500,
    "title": {
        "text": "Top 6 Cities with Largest Number of Major Cultural Events in Australia 2026", 
        "anchor": "middle", 
        "fontSize": 24,
        "offset": 14
    },
    "data": {
        "url": "data/Australian_Cultural_Events_List_2026.csv"
    },

    "config": {
        "view": {"stroke": "transparent"}
    },

    "transform": [
        {
        "aggregate": [
            {
                "op": "count",
                "as": "Event_Count"
            }
        ],
        "groupby": ["City"]
        },
        {
        "window": [
            {
                "op": "rank",
                "as": "Rank"
            }
        ],
        "sort": [
            {
                "field": "Event_Count",
                "order": "descending"
            }
        ]
        },
        {"filter": "datum.Rank <= 6"}
    ],

    "mark": {"type": "bar", "size": 50},

    "encoding": {
        "y": {
            "field": "City",
            "type": "nominal",
            "sort": "-x",
            "title": "City", 
            "axis": {
                "labelFontSize": 12
            }
        },
        "x": {
            "field": "Event_Count",
            "type": "quantitative",
            "title": "Number of Events", 
            "axis": {
                "tickMinStep": 1
            }
        },
        "tooltip": [
            {
                "field": "City",
                "type": "nominal",
                "title": "City"
            },
            {
                "field": "Event_Count",
                "type": "quantitative",
                "title": "Events"
            }
        ]
    }
    }