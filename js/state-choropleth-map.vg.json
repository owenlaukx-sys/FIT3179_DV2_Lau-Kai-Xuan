{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 500,
  "height": 400,
  "projection": {"type": "equirectangular"},
  "data": {
    "url": "js/maps/australia_map.json",
    "format": {
      "type": "topojson",
      "feature": "ne_50m_admin_1_states_provinces"
    }
  },

  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "data/state_event_proportions.csv"
        },
        "key": "State",
        "fields": [
          "Event_Count",
          "Proportion"
        ]
      }
    }
  ],

  "mark": {
    "type": "geoshape",
    "stroke": "white"
  },

  "encoding": {
    "color": {
      "field": "Proportion",
      "type": "quantitative",
      "scale": {
        "scheme": "blues"
      },
      "legend": {
        "title": "Proportion of Events",
        "format": ".0%"
      }
    },

    "tooltip": [
      {
        "field": "properties.name",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "Event_Count",
        "type": "quantitative",
        "title": "Number of Events"
      },
      {
        "field": "Proportion",
        "type": "quantitative",
        "title": "Proportion",
        "format": ".1%"
      }
    ]
  }
}